// 综合启蒙数据模型。
// 开发环境可以不设 DATABASE_URL，接口走内存 + JSON 夹具。
// 生产环境必须有数据库。新增表用新的迁移，不改已有迁移目录。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 家长账号。手机号与微信 openid 都可空，便于以后合并登录。
model User {
  id           String       @id @default(cuid())
  phone        String?      @unique
  wechatOpenId String?      @unique
  nickname     String?
  role         String       @default("parent")
  /// 监护人同意隐私说明的时间。空着表示还没有同意，不能当成已经同意。
  guardianConsentAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  children     Child[]
  orders       Order[]
  entitlements Entitlement[]
  parentLock   ParentLock?
}

/// 儿童档案。ageBand：A=3–4岁，B=4–5岁，C=5–6岁。
model Child {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname  String
  ageBand   String
  avatar    String?
  isCurrent Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  progress  Progress[]
  todayPlans TodayPlan[]
  gameQuotas GameQuota[]

  @@index([userId])
}

/// 产品学科。只给课程馆四个胶囊用：语言 / 数学 / 英语 / 认知。
/// 规划里的七个模块在 CurriculumSubject，不要写进这张表。
model Subject {
  id    String @id
  name  String
  tab   String
  packs Pack[]
}

/// 课包。access：trial 试玩 / locked 锁 / owned 已购。
model Pack {
  id         String    @id
  subjectId  String
  subject    Subject   @relation(fields: [subjectId], references: [id])
  title      String
  summary    String
  levelCount Int
  ageRange   String
  access     String    @default("locked")
  accent     String?
  coverAsset String?
  status     String    @default("published")
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  levels     Level[]

  @@index([subjectId])
}

/// 关卡。config 为 CMS Level JSON（含 schemaVersion、steps、音频位）。
model Level {
  id            String     @id
  packId        String
  pack          Pack       @relation(fields: [packId], references: [id], onDelete: Cascade)
  order         Int
  title         String
  goal          String     @default("")
  ageBand       String[]
  vocab         String[]
  types         String[]
  minutes       Int        @default(2)
  playable      Boolean    @default(false)
  rewardStars   Int        @default(3)
  rewardCopy    String     @default("")
  schemaVersion Int        @default(1)
  config        Json
  status        String     @default("draft")
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  progress      Progress[]
  knowledgeLinks LevelKnowledgePoint[]

  @@unique([packId, order])
  @@index([packId])
}

/// 规划学科。七个模块，不出现在课程馆胶囊里。
model CurriculumSubject {
  id      String             @id
  name    String
  sort    Int
  status  String             @default("active")
  courses CurriculumCourse[]
}

/// 规划专题。id 形如 MA09。生活数学单独成专题，不并进时间认知。
model CurriculumCourse {
  id        String            @id
  subjectId String
  subject   CurriculumSubject @relation(fields: [subjectId], references: [id])
  title     String
  sort      Int
  status    String            @default("active")
  points    KnowledgePoint[]

  @@index([subjectId])
}

/// 知识点。courseId 只表示所属专题，不表示前置。
model KnowledgePoint {
  id               String                 @id
  code             String                 @unique
  courseId         String
  course           CurriculumCourse       @relation(fields: [courseId], references: [id])
  title            String
  difficulty       Int                    @default(1)
  status           String                 @default("active")
  sort             Int
  version          Int                    @default(1)
  ageTargets       Json
  dependenciesFrom KnowledgeDependency[]  @relation("DependencyFrom")
  dependenciesTo   KnowledgeDependency[]  @relation("DependencyTo")
  levelLinks       LevelKnowledgePoint[]

  @@index([courseId])
}

/// 知识点之间的多对多关系。不用 KnowledgePoint.parentId。
model KnowledgeDependency {
  id       String         @id @default(cuid())
  fromId   String
  toId     String
  relation String
  from     KnowledgePoint @relation("DependencyFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to       KnowledgePoint @relation("DependencyTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, relation])
  @@index([toId])
}

/// 关卡到知识点的索引。播放仍读夹具；删掉这张表不影响开课。
model LevelKnowledgePoint {
  id               String         @id @default(cuid())
  levelId          String
  level            Level          @relation(fields: [levelId], references: [id], onDelete: Cascade)
  knowledgePointId String
  knowledgePoint   KnowledgePoint @relation(fields: [knowledgePointId], references: [id], onDelete: Cascade)
  stepId           String         @default("")

  @@unique([levelId, knowledgePointId, stepId])
  @@index([knowledgePointId])
}

/// 游戏乐园。config 含时长、每日免费次数、胜利条件、素材引用。
model Game {
  id            String    @id
  title         String
  titleEn       String?
  knowledgeTags String[]
  dailyFree     Int       @default(3)
  durationSec   Int
  rounds        String?
  winCondition  String
  howTo         String
  playable      Boolean   @default(false)
  schemaVersion Int       @default(1)
  config        Json
  status        String    @default("published")
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// 学习进度。clientEventId 用于完成上报幂等。
model Progress {
  id            String    @id @default(cuid())
  childId       String
  child         Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  levelId       String
  level         Level     @relation(fields: [levelId], references: [id], onDelete: Cascade)
  status        String    @default("started")
  stars         Int       @default(0)
  score         Int       @default(0)
  durationSec   Int       @default(0)
  clientEventId String?   @unique
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([childId, levelId])
  @@index([childId])
}

/// 订单。channel：wechat / apple_iap / stub。金额单位为分。
model Order {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skuId     String
  channel   String
  status    String   @default("pending")
  amount    Int
  currency  String   @default("CNY")
  payParams Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

/// 权益。type：no_ads / pack / vip_year / ad_unlock。
model Entitlement {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  childId   String?
  type      String
  scope     String?
  expireAt  DateTime?
  source    String
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// 家长锁。只存 pinHash。开发环境的占位哈希不能在生产环境当作演示密码。
model ParentLock {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pinHash     String
  failCount   Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

/// 当天固定的今日任务。重启后仍显示同一组关卡和完成勾。
model TodayPlan {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  day       String
  ageBand   String
  levelIds  String[]
  updatedAt DateTime @updatedAt

  @@unique([childId, day])
  @@index([childId])
}

/// 游戏每日次数。按孩子、游戏和本地日期计。
model GameQuota {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  gameId    String
  day       String
  used      Int      @default(0)
  bonus     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([childId, gameId, day])
  @@index([childId, day])
}

/// 素材登记。运行时内容只引用 assetId，正式环境再解析成 CDN URL。
model Asset {
  id        String    @id @default(cuid())
  kind      String
  cdnUrl    String?
  tags      String[]
  status    String    @default("draft")
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
