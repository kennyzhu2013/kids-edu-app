# 复制为 .env 后，仅在要连 PostgreSQL 时需要改 DATABASE_URL。
# 本地 `npm run dev` 不连接数据库，接口使用内存桩 + JSON 夹具。

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zonghe_qimeng?schema=public"

# 家长锁密码。开发环境默认 2580。生产环境不要使用 2580，库里只存哈希。
PARENT_LOCK_PIN="2580"

# 后台接口令牌：请求头 x-admin-token。生产环境不要使用 dev-admin。
ADMIN_TOKEN="dev-admin"

# --- 以下全部未接入，保留变量名方便以后填 ---
# TODO: 短信服务商（阿里云 / 腾讯云）。开发环境验证码固定为 000000，生产环境不会发放这组验证码。
SMS_PROVIDER="stub"
SMS_ACCESS_KEY=""
SMS_ACCESS_SECRET=""

# TODO: 微信开放平台 / 小程序登录
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""

# TODO: 微信支付与 Apple IAP
PAY_CHANNEL="stub"
WECHAT_MCH_ID=""
WECHAT_API_V3_KEY=""
APPLE_IAP_SHARED_SECRET=""

# TODO: 激励视频广告 SDK（Web 占位，App 再接真 SDK）
AD_SDK="stub"
AD_REWARD_UNIT_ID=""

# App 壳 WebView 要打开的网页。模拟器访问本机开发服时再改成电脑的局域网地址。
# CAPACITOR_SERVER_URL="http://127.0.0.1:41731"
